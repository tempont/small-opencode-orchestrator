{
  "$schema": "https://opencode.ai/config.json",

  // No plugins: plan-post-approval was removed; approval no longer triggers automation.

  // Per-agent temperatures dropped: the opencode-go gateway rejects config-declared variant IDs at session-create (only catalog variants low/high/max/xhigh validate). Catalog reasoning variants apply as in V1.

  "default_agent": "orchestrator",
  "share": "manual",
  "update": "auto",

  // V2 todos are off by default; orchestrator/plan-runner rely on todowrite.
  "experimental": { "todo": true },

  // V1 external_directory defaulted to ask; V2 defaults to allow.
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
  ],

  "agents": {
    "build": { "model": "opencode-go/glm-5.3-flash#max" },
    "plan": { "model": "opencode-go/glm-5.3-flash#max" },
    "orchestrator": { "model": "opencode-go/glm-5.3-flash#max" },

    "plan-runner": { "model": "opencode-go/deepseek-v4.1-flash#max" },
    "code-explorer": { "model": "opencode-go/deepseek-v4.1-flash#max" },
    "code-executor": { "model": "opencode-go/deepseek-v4.1-flash#max" },
    "test-verifier": { "model": "opencode-go/deepseek-v4.1-flash#max" },
    "spec-critic": { "model": "opencode-go/deepseek-v4.1-flash#max" },
    "security-reviewer": { "model": "opencode-go/deepseek-v4.1-flash#max" },
    "docs-reviewer": { "model": "opencode-go/deepseek-v4.1-flash#max" },
    "code-reviewer": { "model": "opencode-go/deepseek-v4.1-flash#max" },
    "api-docs-researcher": { "model": "opencode-go/deepseek-v4.1-flash#max" },
    "host-security-investigator": { "model": "opencode-go/deepseek-v4.1-flash#max" },

    // small_model → title agent model (no variant in V1, keep none).
    "title": { "model": "opencode-go/deepseek-v4.1-flash" },
  },
}
