{
  "$schema": "https://opencode.ai/config.json",

  "provider": {},

  "default_agent": "orchestrator",
  "share": "manual",
  "autoupdate": true,

  // Minimal workspace baseline; per-agent tool policy lives in agents/<id>.md frontmatter. If you want it more permissive you can copy to your project workspace ./opencode/opencode.jsonc with "allow" instead
  "permission": {
    "bash": {
      "*": "ask",
    },
    "edit": "ask",
  },

  // Strong models for the primary agents
  "agent": {
    "build": {
      "model": "opencode-go/qwen3.8-flash",
      "variant": "xhigh",
    },

    "plan": {
      "model": "opencode-go/qwen3.8-flash",
      "variant": "xhigh",
    },

    "orchestrator": {
      "model": "opencode-go/qwen3.8-flash",
      "temperature": 0.2,
      "variant": "xhigh",
    },

    "plan-runner": {
      // stick with mimo-v2.5 here aswell if you accept the thinking tradeoff
      "model": "opencode-go/mimo-v2.5",
      "temperature": 0.2,
    },

    // Cheap model for subagents (defined in agents/<id>.md)
    "code-explorer": {
      "model": "opencode-go/mimo-v2.5",
      "temperature": 0.2,
    },

    "code-executor": {
      "model": "opencode-go/mimo-v2.5",
      "temperature": 0.1,
    },

    "test-verifier": {
      "model": "opencode-go/mimo-v2.5",
      "temperature": 0.1,
    },

    "spec-critic": {
      "model": "opencode-go/mimo-v2.5",
      "temperature": 0.4,
    },

    "security-reviewer": {
      "model": "opencode-go/mimo-v2.5",
      "temperature": 0.1,
    },

    "docs-reviewer": {
      "model": "opencode-go/mimo-v2.5",
      "temperature": 0.1,
    },

    "code-reviewer": {
      "model": "opencode-go/mimo-v2.5",
      "temperature": 0.1,
    },

    "api-docs-researcher": {
      "model": "opencode-go/mimo-v2.5",
      "temperature": 0.1,
    },

    "host-security-investigator": {
      "model": "opencode-go/mimo-v2.5",
      "temperature": 0.1,
    },
  },
}
