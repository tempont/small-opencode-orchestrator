{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "orchestrator",
  "share": "manual",
  "update": "auto",

  // V2 todos are off by default; orchestrator/plan-runner rely on todowrite.
  "experimental": { "todo": true },

  // Minimal workspace baseline; per-agent tool policy lives in agents/<id>.md frontmatter. If you want it more permissive you can copy to your project workspace ./opencode/opencode.jsonc with "allow" instead
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
  ],

  "agents": {
    // Strong model for the primary agents
    "build": { "model": "opencode-go/glm-5.3-flash#max" },
    "plan": {
      "model": "opencode-go/glm-5.3-flash#max",
      // Re-pin shipped edit scope (configured rules append after the global ask baseline).
      "permissions": [
        { "action": "edit", "resource": "**/.opencode/plans/**", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/plans/**", "effect": "allow" },
        { "action": "edit", "resource": "**/.opencode/plan/**", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/plan/**", "effect": "allow" },
      ],
    },
    "orchestrator": { "model": "opencode-go/glm-5.3-flash#max" },

    // Cheap model for subagents (defined in agents/<id>.md)
    "plan-runner": { "model": "opencode-go/qwen3.8-flash#xhigh" },
    "code-explorer": { "model": "opencode-go/qwen3.8-flash#xhigh" },
    "code-executor": { "model": "opencode-go/qwen3.8-flash#xhigh" },
    "test-verifier": { "model": "opencode-go/qwen3.8-flash#xhigh" },
    "spec-critic": { "model": "opencode-go/qwen3.8-flash#xhigh" },
    "security-reviewer": { "model": "opencode-go/qwen3.8-flash#xhigh" },
    "docs-reviewer": { "model": "opencode-go/qwen3.8-flash#xhigh" },
    "code-reviewer": { "model": "opencode-go/qwen3.8-flash#xhigh" },
    "api-docs-researcher": { "model": "opencode-go/qwen3.8-flash#xhigh" },
    "host-security-investigator": { "model": "opencode-go/qwen3.8-flash#xhigh" },

    // Re-pin shipped builtin policy for explore as a configured agent rule (they append
    // after the global ask baseline, so they win for this entry).
    "explore": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "allow" },
      ],
    },

    // Cheap maintenance-agent pins.
    "title": { "model": "opencode-go/qwen3.8-flash" },
    "summary": { "model": "opencode-go/qwen3.8-flash" },
    "compaction": { "model": "opencode-go/qwen3.8-flash" },
  },
}
